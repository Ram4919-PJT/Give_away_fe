# Dev: Vite proxies /api/v1 → http://localhost:8000 (see vite.config.js)
VITE_IAM_API_URL=/api/v1

# Separate Admin Portal URL (user app redirects admins here)
VITE_ADMIN_PORTAL_URL=http://localhost:5174

# Production example (set in .env.production):
# VITE_IAM_API_URL=https://api.yourdomain.com/api/v1
